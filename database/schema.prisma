generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id        String    @id @default(uuid())
  nome      String
  criadoEm  DateTime  @default(now())
  unidades  Unidade[]
  alimentos Alimento[]
  usuarios  Usuario[]
  metas     MetaDesperdicio[]
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  papel     String   @default("ADMIN")
  empresaId String
  criadoEm  DateTime @default(now())
  empresa   Empresa  @relation(fields: [empresaId], references: [id])

  @@index([empresaId])
}

model Unidade {
  id        String     @id @default(uuid())
  nome      String
  empresaId String
  empresa   Empresa    @relation(fields: [empresaId], references: [id])
  descartes Descarte[]
  metas     MetaDesperdicio[]
  @@index([empresaId])
}

model Alimento {
  id          String     @id @default(uuid())
  nome        String
  categoria   String?
  custoPorKg  Decimal    @db.Decimal(10, 2)
  empresaId   String
  empresa     Empresa    @relation(fields: [empresaId], references: [id])
  descartes   Descarte[]
  @@unique([empresaId, nome])
}

model MetaDesperdicio {
  id           String   @id @default(cuid())
  empresaId    String
  unidadeId    String?
  ano          Int
  mes          Int
  valorMeta    Decimal  @db.Decimal(12, 2)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresa Empresa  @relation(fields: [empresaId], references: [id])
  unidade Unidade? @relation(fields: [unidadeId], references: [id])

  @@unique([empresaId, unidadeId, ano, mes])
  @@index([empresaId, ano, mes])
  @@index([unidadeId, ano, mes])
}

model Descarte {
  id          String    @id @default(uuid())
  unidadeId   String
  alimentoId  String
  quantidadeKg Decimal  @db.Decimal(10, 3)
  motivo      String
  imagemUrl   String?
  custoTotal  Decimal   @db.Decimal(10, 2)
  criadoEm    DateTime  @default(now())
  unidade     Unidade   @relation(fields: [unidadeId], references: [id])
  alimento    Alimento  @relation(fields: [alimentoId], references: [id])
  @@index([unidadeId, criadoEm])
  @@index([alimentoId])
}
